# Copy to .env for local development. In production these are set in the hosting dashboard.
# See DEPLOY.md for what each one means.

# Database file. Local: file:./dev.db. Production: a path on the persistent volume, e.g. file:/data/hashoval.db
DATABASE_URL="file:./dev.db"

# Admin login. In production: password of at least 12 characters, secret of at least 32 random characters.
ADMIN_PASSWORD="change-me"
SESSION_SECRET="change-me-to-a-long-random-string"

# Email (Resend). EMAIL_FROM must look like: hashoval <orders@your-domain>
OWNER_EMAIL=""
RESEND_API_KEY=""
EMAIL_FROM=""

# Payments. "mock" shows a fake payment page (no real money). Leave unset in production once a real provider exists.
# Local development uses the mock automatically; production needs PAYMENT_PROVIDER=mock to allow it.
PAYMENT_PROVIDER=""

# Production only: where uploaded images and backups are stored (on the persistent volume).
UPLOAD_DIR=""
BACKUP_DIR=""

# Optional: password-protects the whole site (for a private test site). Leave empty to open it to everyone.
SITE_PASSWORD=""
